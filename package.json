{
  "name": "ksakit",
  "version": "0.1.0",
  "description": "Developer utilities built for Saudi applications — Arabic numbers, Saudi phone, IBAN, VAT, currency, and Arabic text normalization.",
  "type": "module",
  "main": "./dist/index.js",
